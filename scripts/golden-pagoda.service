[Unit]
Description=Golden Pagoda Discord verification bot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
# `docker stop` SIGKILLs the container after the grace period — exit 137 is
# expected on `systemctl stop` and should not be treated as a failure.
SuccessExitStatus=0 137 143
TimeoutStopSec=20
WorkingDirectory=/opt/golden-pagoda
ExecStartPre=-/usr/bin/docker rm -f golden-pagoda
ExecStartPre=-/bin/mkdir -p /opt/golden-pagoda/data /opt/golden-pagoda/icons
ExecStartPre=-/bin/chown -R 10001:10001 /opt/golden-pagoda/data
# The bot rewrites .env in-place when /clan-emblems is used; the container
# user (uid 10001) must own the file. Idempotent — fine if already correct.
ExecStartPre=-/bin/chown 10001:10001 /opt/golden-pagoda/.env
ExecStartPre=-/bin/chmod 0600 /opt/golden-pagoda/.env
ExecStart=/usr/bin/docker run --rm --name golden-pagoda --init \
    --pull=never \
    --memory=512m --memory-swap=512m \
    --cpus=1 \
    --pids-limit=256 \
    --log-driver=json-file \
    --log-opt max-size=10m \
    --log-opt max-file=3 \
    --env-file /opt/golden-pagoda/.env \
    -e ENV_FILE_PATH=/app/.env \
    -v /opt/golden-pagoda/.env:/app/.env \
    -v /opt/golden-pagoda/icons:/app/icons \
    -v /opt/golden-pagoda/data:/app/data \
    golden-pagoda:latest
ExecStop=/usr/bin/docker stop -t 15 golden-pagoda

[Install]
WantedBy=multi-user.target
