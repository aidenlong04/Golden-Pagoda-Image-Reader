# Golden Pagoda — environment template.
# Copy to .env (`cp .env.example .env`) and fill in the required values.
# On the Hetzner host the real file lives at /opt/golden-pagoda/.env and is the
# source of truth (it is excluded from the deploy rsync). Never commit a real .env.
#
# Values shown after "=" are the built-in defaults; blank means "unset".
# IDs left blank that have a role NAME counterpart are auto-resolved on connect
# and written back here by the bot.

# ---- Required ----
DISCORD_TOKEN=
TARGET_CHANNEL_ID=

# ---- OCR (OCR.space engine 3; falls back to local Tesseract if key is blank) ----
OCR_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image
OCR_ENGINE=3
OCR_LANGUAGE=eng
OCR_MAX_UPLOAD_BYTES=900000
OCR_RECOMPRESS_QUALITY=70

# ---- Platform role IDs (auto-resolved from role name on connect) ----
PLATFORM_ROLE_PC_ID=
PLATFORM_ROLE_XBOX_ID=
PLATFORM_ROLE_PLAYSTATION_ID=
PLATFORM_ROLE_SWITCH_ID=
PLATFORM_ROLE_MOBILE_ID=

# ---- Platform custom emojis (<:name:id> format) ----
PLATFORM_EMOJI_PC=
PLATFORM_EMOJI_XBOX=
PLATFORM_EMOJI_PLAYSTATION=
PLATFORM_EMOJI_SWITCH=
PLATFORM_EMOJI_MOBILE=

# ---- Clan slots (7). Names auto-resolve to IDs on connect. EMOJI is <:name:id> ----
CLAN_ROLE_1_NAME=
CLAN_ROLE_1_ID=
CLAN_ROLE_1_EMOJI=
CLAN_ROLE_2_NAME=
CLAN_ROLE_2_ID=
CLAN_ROLE_2_EMOJI=
CLAN_ROLE_3_NAME=
CLAN_ROLE_3_ID=
CLAN_ROLE_3_EMOJI=
CLAN_ROLE_4_NAME=
CLAN_ROLE_4_ID=
CLAN_ROLE_4_EMOJI=
CLAN_ROLE_5_NAME=
CLAN_ROLE_5_ID=
CLAN_ROLE_5_EMOJI=
CLAN_ROLE_6_NAME=
CLAN_ROLE_6_ID=
CLAN_ROLE_6_EMOJI=
CLAN_ROLE_7_NAME=
CLAN_ROLE_7_ID=
CLAN_ROLE_7_EMOJI=

# ---- Verification-flow roles / channels ----
INCOMPLETE_ROLE_ID=
VERIFY_REMOVE_ROLE_ID=
HELP_CHANNEL_ID=

# ---- Mastery-rank + syndicate role buckets (NAMES resolve to _IDS on connect) ----
MR_ROLE_NAMES=MR 1-10,MR 11-15,MR 16-22,MR 22-29,MR 30,LR 1-7
SYNDICATE_ROLE_NAMES=Steel Meridian,Arbiters of Hexis,Cephalon Suda,The Perrin Sequence,Red Veil,New Loka
MR_ROLE_IDS=
SYNDICATE_ROLE_IDS=

# ---- Reactions on the original screenshot (0 disables) ----
PASS_REACTION_ID=
FAIL_REACTION=🚨
PENDING_REACTION_ID=

# ---- Card / response emojis (<:name:id>) ----
OPERATOR_EMOJI=
MASTERY_RANK_EMOJI=
SYNDICATE_EMOJI=
WARNING_EMOJI=
CLAN_EMOJI=

# ---- V2 accent colors (hex) ----
ACCENT_PASS=0xD4A857
ACCENT_FAIL=0xED4245
ACCENT_INCOMPLETE=0x99AAB5

# ---- Behavior ----
REPLY_TTL_SECONDS=180
CATCHUP_LOOKBACK_HOURS=24
CATCHUP_STATE_PATH=/app/data/catchup_state.json
CATCHUP_DELAY_SECONDS=1.0
HEALTH_PATH=/tmp/gp_health
HEALTH_INTERVAL=20
ANALYTICS_DB_PATH=/app/data/analytics.db
LOG_LEVEL=INFO
