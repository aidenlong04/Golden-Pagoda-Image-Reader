# Golden Pagoda — environment template.
# Copy to .env (`cp .env.example .env`, or `Copy-Item .env.example .env` in
# PowerShell) and fill in the required values. Run the bot locally with
# `python bot.py` (or `./run.ps1` on Windows). Never commit a real .env.
#
# Values shown after "=" are the built-in defaults; blank means "unset".
# IDs left blank that have a role NAME counterpart are auto-resolved on connect
# and written back here by the bot.

# ---- Required ----
DISCORD_TOKEN=
TARGET_CHANNEL_ID=

# ---- OCR backends ----
# Preferred (local, offline): set OLLAMA_OCR_MODEL to a pulled Ollama vision
# model (e.g. `ollama pull llama3.2-vision`) and run `ollama serve`. When set,
# the bot reads screenshots through Ollama and needs no API key.
OLLAMA_OCR_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
# Fallback: OCR.space engine 3 (needs OCR_API_KEY) then local Tesseract.
OCR_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image
OCR_ENGINE=3
OCR_LANGUAGE=eng
OCR_MAX_UPLOAD_BYTES=900000
OCR_RECOMPRESS_QUALITY=70
# Connect timeout (seconds) for every OCR HTTP call — a down/refusing
# backend fails over to the next engine this fast instead of waiting out
# the full read timeout.
OCR_CONNECT_TIMEOUT=5

# ---- Platform role IDs (auto-resolved from role name on connect) ----
PLATFORM_ROLE_PC_ID=
PLATFORM_ROLE_XBOX_ID=
PLATFORM_ROLE_PLAYSTATION_ID=
PLATFORM_ROLE_SWITCH_ID=
PLATFORM_ROLE_MOBILE_ID=

# ---- Platform custom emojis (<:name:id> format) ----
PLATFORM_EMOJI_PC=
PLATFORM_EMOJI_XBOX=
PLATFORM_EMOJI_PLAYSTATION=
PLATFORM_EMOJI_SWITCH=
PLATFORM_EMOJI_MOBILE=

# ---- Clan slots (7). Names auto-resolve to IDs on connect. EMOJI is <:name:id> ----
CLAN_ROLE_1_NAME=
CLAN_ROLE_1_ID=
CLAN_ROLE_1_EMOJI=
CLAN_ROLE_2_NAME=
CLAN_ROLE_2_ID=
CLAN_ROLE_2_EMOJI=
CLAN_ROLE_3_NAME=
CLAN_ROLE_3_ID=
CLAN_ROLE_3_EMOJI=
CLAN_ROLE_4_NAME=
CLAN_ROLE_4_ID=
CLAN_ROLE_4_EMOJI=
CLAN_ROLE_5_NAME=
CLAN_ROLE_5_ID=
CLAN_ROLE_5_EMOJI=
CLAN_ROLE_6_NAME=
CLAN_ROLE_6_ID=
CLAN_ROLE_6_EMOJI=
CLAN_ROLE_7_NAME=
CLAN_ROLE_7_ID=
CLAN_ROLE_7_EMOJI=

# ---- Verification-flow roles / channels ----
INCOMPLETE_ROLE_ID=
VERIFY_REMOVE_ROLE_ID=
HELP_CHANNEL_ID=
# Custom emoji ID for the /profile "Assign <category>" link buttons.
ASSIGN_ROLE_EMOJI_ID=
# Comma-separated role IDs allowed to make a /profile reply public (flip the
# `ephemeral` toggle off); server managers are always allowed. /profile is open
# to everyone and anyone may target any member — only `ephemeral` is gated.
# Blank = baked-in IDs.
PROFILE_OPTIONS_ROLE_IDS=

# ---- Mastery-rank + syndicate role buckets (NAMES resolve to _IDS on connect) ----
# Per-rank vanity roles: MR 1..MR 30 then Legendary 1..Legendary 8 (Legendary is
# the post-MR-30 prestige tier of mastery). Create them with
# scripts/setup_mastery_roles.py, which also writes MR_ROLE_IDS back here.
MR_ROLE_NAMES=MR 1,MR 2,MR 3,MR 4,MR 5,MR 6,MR 7,MR 8,MR 9,MR 10,MR 11,MR 12,MR 13,MR 14,MR 15,MR 16,MR 17,MR 18,MR 19,MR 20,MR 21,MR 22,MR 23,MR 24,MR 25,MR 26,MR 27,MR 28,MR 29,MR 30,Legendary 1,Legendary 2,Legendary 3,Legendary 4,Legendary 5,Legendary 6,Legendary 7,Legendary 8
SYNDICATE_ROLE_NAMES=Steel Meridian,Arbiters of Hexis,Cephalon Suda,The Perrin Sequence,Red Veil,New Loka
MR_ROLE_IDS=
SYNDICATE_ROLE_IDS=

# ---- Card / response emojis (<:name:id>) ----
OPERATOR_EMOJI=
MASTERY_RANK_EMOJI=
SYNDICATE_EMOJI=
WARNING_EMOJI=
CLAN_EMOJI=

# ---- Per-faction syndicate emojis for the /profile card (<:name:id>) ----
# One per canonical Warframe syndicate; blank falls back to SYNDICATE_EMOJI
# (or a bullet). The faction name colour is hardcoded in bot.py.
SYNDICATE_EMOJI_STEEL_MERIDIAN=<:SteelMeridianFlag:1490177047920906261>
SYNDICATE_EMOJI_ARBITERS_OF_HEXIS=<:ArbitersofHexisFlag:1490176988894203955>
SYNDICATE_EMOJI_CEPHALON_SUDA=<:CephalonSudaFlag:1490176913661235220>
SYNDICATE_EMOJI_THE_PERRIN_SEQUENCE=<:ThePerrinSequenceFlag:1490176841875456111>
SYNDICATE_EMOJI_RED_VEIL=<:RedVeil:1490176777836953701>
SYNDICATE_EMOJI_NEW_LOKA=<:NewLokaFlag:1490176705309048953>

# ---- V2 accent colors (hex) ----
ACCENT_PASS=0xD4A857
ACCENT_FAIL=0xED4245
ACCENT_INCOMPLETE=0x99AAB5

# ---- Behavior ----
# Local-friendly paths (relative to the working dir). The ./data folder is
# created on first run; override with absolute paths if you prefer.
REPLY_TTL_SECONDS=180
HEALTH_PATH=./data/gp_health
HEALTH_INTERVAL=20
ANALYTICS_DB_PATH=./data/analytics.db
# user_id -> [record message_ids] index for fast member-record lookups.
RECORDS_INDEX_PATH=./data/records_index.json
LOG_LEVEL=INFO

# ---- Member onboarding ----
# Channel where the join-welcome prompt is posted.  Defaults to
# TARGET_CHANNEL_ID when unset (backwards-compatible).
ONBOARDING_CHANNEL_ID=1361846841934610568
# Channel (or thread) where the member's uploaded screenshot is posted as a
# record after successful verification. May be a thread ID. Set to 0 (or leave
# blank) to disable the record. Changing this requires a bot restart.
MEMBER_RECORDS_CHANNEL_ID=1516374946660749312
# Hours before re-posting the welcome prompt if the member hasn't completed.
ONBOARDING_REPROMPT_HOURS=5
# Maximum number of re-prompts per member (stop after this many re-posts).
ONBOARDING_MAX_REPROMPTS=3
# Consecutive OCR failures before routing to manual review.
ONBOARDING_MAX_OCR_FAILS=3
# Polling interval (seconds) for the reprompt sweep task.
ONBOARDING_POLL_SECONDS=600

# ---- /watch fishing-screenshot watcher ----
# All values are managed by the /watch panel (Start / Stop /
# Codewords / Set admin) and written back here so the watcher survives
# restarts. FISH_WATCH_ENABLED: 1 = watching, 0 = stopped.
FISH_WATCH_ENABLED=0
# Channel whose image submissions are watched (set via /watch channel:).
FISH_WATCH_CHANNEL_ID=
# The currently detected codeword — set by a watch admin typing one of the
# known codewords in the watched channel. Members must have it highlighted
# in green in their chat box. A new codeword only applies to newly sent
# images.
FISH_WATCH_CODEWORD=
# Comma-separated list of known codewords the watcher detects from watch
# admin messages (set via the /watch Codewords button).
FISH_WATCH_CODEWORDS=
# Comma-separated user IDs whose fish-name messages set the watched fish.
FISH_WATCH_ADMIN_IDS=
# The fish currently being watched (set by an admin naming a fish in the
# watched channel).
FISH_WATCH_FISH=

# ---- Performance tuning (new in performance-improvements branch) ----
# Maximum concurrent heavy jobs (card renders + OCR). Raise to 3-4 only
# after confirming memory headroom via /status → Latency → semaphore peak.
# Default: 2 (conservative for low-memory machines).
HEAVY_JOB_CONCURRENCY=2

# OCR.space API retry strategy (exponential back-off with jitter).
# Max total attempts (including first try). Base delay in seconds.
# Max delay cap in seconds.
OCR_RETRY_MAX_ATTEMPTS=3
OCR_RETRY_BASE_DELAY=1.0
OCR_RETRY_MAX_DELAY=30.0

# OCR.space circuit breaker. Opens after this many consecutive failures
# and stays open for RECOVERY seconds before allowing a probe.
OCR_CIRCUIT_BREAKER_THRESHOLD=5
OCR_CIRCUIT_BREAKER_RECOVERY=60

# LRU cache size for OCR results (keyed by SHA-256 of image bytes).
# Set to 0 to disable caching.
OCR_CACHE_SIZE=32

# analytics.summary() result TTL in seconds. /status refreshes within this
# window return the cached snapshot without hitting SQLite.
ANALYTICS_SUMMARY_TTL=30

# Discord API retry limit for role assignments/removals (rate-limit retries).
DISCORD_RETRY_MAX=3

# Rolling window size (number of recent samples) for in-process latency
# recorders (OCR, analytics query) shown on /status → Latency.
METRICS_LATENCY_WINDOW=500
